{
  "compilerOptions": {
    "strict": false,
    "noImplicitAny": false,
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom"],
    "types": ["materialize-css"],
    "useDefineForClassFields": false,
    "experimentalDecorators": true,
    "importHelpers": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "noUncheckedSideEffectImports": false
  },
  "angularCompilerOptions": {
    "strictTemplates": false
  },
  "include": [
    "src/angular/**/*.ts"
  ],
  "exclude": [
    "./node_modules/**",
    "**/main.aot.ts"
  ]
}
